# Copiar este archivo como .env y completar con valores reales.
# Nunca commitear el archivo .env con valores reales.

# Puerto en el que corre la API
PORT=3000

# Ambiente: development | test | production
NODE_ENV=development

# Origen permitido para CORS (dominio del frontend). No usar "*" en producción.
ALLOWED_ORIGIN=http://localhost:5173

# Cadena de conexión a PostgreSQL (Prisma).
# IMPORTANTE (docs/security.md, punto 19 — mínimo privilegio): usar un rol de
# base de datos propio de la aplicación, NUNCA el superusuario (`postgres`).
# Ese rol debe tener solo los permisos que la app necesita sobre su propio
# schema (SELECT/INSERT/UPDATE/DELETE; sin DROP/ALTER/CREATE en producción).
# El superusuario está bien para desarrollo local aislado, pero nunca debe
# usarse en un ambiente compartido, de demo o de producción.
DATABASE_URL="postgresql://usuario_app:password@localhost:5432/proyecto_titulo_aaa?schema=public"

# --- Autenticación (PROMPT 03) ---------------------------------------------

# Secretos de firma de los JWT. OBLIGATORIOS. Deben ser valores largos y
# aleatorios, distintos entre sí y distintos por ambiente. Nunca reutilizar
# el mismo secreto para access y refresh, ni commitear un valor real aquí.
# Generar uno, por ejemplo, con: openssl rand -base64 48
JWT_ACCESS_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio-de-access"
JWT_REFRESH_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio-de-refresh"

# Vigencia del access token y del refresh token (formato aceptado por la
# librería `ms`: "15m", "7d", etc.). Ver docs/security.md, punto 1.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Vigencia del token de invitación de alumno, en horas.
INVITATION_EXPIRES_IN_HOURS=168

# Rate limiting reforzado para /auth/login, /auth/register, /auth/refresh y
# /auth/activate (docs/security.md, punto 11). Bajar el límite / mantener el
# ttl en producción; se puede relajar en desarrollo local si molesta.
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# Brevo: usar SMTP Login de Settings > SMTP & API, no necesariamente el correo de registro.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=Proyecto AAA
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
